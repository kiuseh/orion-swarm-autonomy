               <property name="styleSheet">
                <string notr="true">/* Ana Kutu - Dış çerçeve burada tanımlanır */
QDoubleSpinBox {
    background-color: #000000;
    color: #00FFC2;
    border: 1.5px solid #00D1FF; /* Ana Turkuaz Çerçeve */
    border-radius: 6px;
    padding-left: 10px;
    font-family: 'Consolas', monospace;
    font-size: 15px;
    font-weight: bold;
    min-height: 40px;
}

/* Yukarı Butonu */
QDoubleSpinBox::up-button {
    subcontrol-origin: border;
    subcontrol-position: top right;
    width: 30px;
    height: 20px;
    background-color: #12161c;
    /* ÖNEMLİ: Çerçevenin ana kutuyla çakışmaması için sağ ve üst kenarı şeffaf yapıyoruz */
    border-left: 1.5px solid #00D1FF;
    border-bottom: 0.75px solid #00D1FF;
    border-top-right-radius: 5px;
}

/* Aşağı Butonu */
QDoubleSpinBox::down-button {
    subcontrol-origin: border;
    subcontrol-position: bottom right;
    width: 30px;
    height: 20px;
    background-color: #12161c;
    /* Sağ ve alt kenar ana kutunun çerçevesini kullansın diye boş bırakılır */
    border-left: 1.5px solid #00D1FF;
    border-top: 0.75px solid #00D1FF;
    border-bottom-right-radius: 5px;
}

/* İşaretler (Genişlikleri ve konumları sabitlendi) */
QDoubleSpinBox::up-arrow {
    image: none;
    background-color: #00FFC2;
    width: 12px; height: 2px;
    border-left: 5px solid #12161c; /* Dikey boşluk hilesi */
    border-right: 5px solid #12161c;
}

QDoubleSpinBox::down-arrow {
    image: none;
    background-color: #FF3131;
    width: 12px; height: 2px;
}

/* HOVER DURUMLARI - Çerçevenin bozulmaması için sadece iç rengi değiştirir */
QDoubleSpinBox::up-button:hover { background-color: #00D1FF; }
QDoubleSpinBox::down-button:hover { background-color: #FF3131; }</string>
