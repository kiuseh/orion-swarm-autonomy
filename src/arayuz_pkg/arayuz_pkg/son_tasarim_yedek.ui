  <property name="styleSheet">
   <string notr="true">/* TÜM PENCERE ARKA PLANI */
QMainWindow { 
    background-color: #0F1219; 
}

/* TEXT EDIT - LOG VE MESAJ EKRANI */
QTextEdit {
    background-color: #0D1117; 
    color: #00FFC2;           
    border: 1px solid #30363D;
    border-left: 3px solid #00D1FF; 
    border-radius: 4px;
    font-family: 'Consolas', 'Monaco', 'Courier New'; 
    font-size: 11px;
    padding: 8px;
}

/* KAYDIRMA ÇUBUĞU TASARIMI (Scrollbar) */
QScrollBar:vertical {
    border: none;
    background: #161B22;
    width: 10px;
    margin: 0px;
}
QScrollBar::handle:vertical {
    background: #30363D;
    min-height: 20px;
    border-radius: 5px;
}
QScrollBar::handle:vertical:hover {
    background: #00D1FF; 
}

/* GRUP KUTULARI (İHA Panelleri) */
QGroupBox {
    background-color: #161B22;
    border: 1px solid #30363D;
    border-radius: 8px;
    margin-top: 20px;
    color: #58A6FF;
    font-weight: bold;
}

/* LCD GÖSTERGELER */
QLCDNumber {
    background-color: #000000;
    color: #00FFC2;
    border: 1px solid #30363D;
}

/* BUTONLAR */
QPushButton {
    background-color: #1F6FEB;
    color: white;
    border-radius: 5px;
    font-weight: bold;
    border: 1px solid #388BFD;
}

QPushButton:hover {
    background-color: #388BFD;
}

QPushButton:disabled {
    background-color: #21262D;
    color: #8B949E;
}

/* --- SADECE EKLENEN BATARYA KISMI --- */
QProgressBar {
    border: 1px solid #30363D;
    border-radius: 4px;
    text-align: center;
    background-color: #0D1117;
    color: white;
    font-weight: bold;
}

QProgressBar::chunk {
    background-color: #00F2FF; 
    width: 4px;                
    margin: 1px;               
}

/* --- SADECE EKLEDİĞİMİZ ETİKETLER --- */
QLabel {
    color: #C9D1D9;
    font-weight: bold;
    background: transparent;
}</string>
