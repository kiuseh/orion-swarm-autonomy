               <property name="styleSheet">
                <string notr="true">QLabel {
    /* Yazı Tipi ve Gümüş Rengi */
    color: #E0E0E0; 
    font-family: 'Consolas', 'Segoe UI', monospace;
    font-size: 19px;
    font-weight: bold;
    letter-spacing: 1px;
    
    /* Arka Plan: Koyu Füme Gradyan */
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, 
                                      stop:0 rgba(30, 30, 30, 0.9), 
                                      stop:1 rgba(15, 15, 15, 0.95));
    
    /* Çerçeve Tasarımı */
    border: 1px solid #A0A0A0;
    border-top: 2px solid #FFFFFF; /* Parlak üst çizgi */
    border-radius: 4px;
    
    /* Hizalama ve Boşluk */
    padding: 3px 8px;
    qproperty-alignment: 'AlignCenter';
}

/* --- HOVER ETKİSİ --- */
QLabel:hover {
    /* Yazı saf beyaza dönerek parlar */
    color: #FFFFFF; 
    
    /* Çerçeve gümüşten parlak beyaza geçer */
    border-color: #FFFFFF;
    
    /* Arka plan hafifçe aydınlanır (metalik parlama hissi) */
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, 
                                      stop:0 rgba(50, 50, 50, 0.95), 
                                      stop:1 rgba(30, 30, 30, 0.98));
    
    /* Hafif bir gölge/ışıltı efekti (Opsiyonel) */
    border-top: 3px solid #FFFFFF;
}</string>
