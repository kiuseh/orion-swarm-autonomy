                 <property name="styleSheet">
                  <string notr="true">QLineEdit {
    background-color: #000000;
    color: white; /* Yazılar tamamen beyaz */
    border: 1.5px solid #00D1FF; /* Senin ikonik turkuaz çerçeven */
    border-radius: 6px;
    padding-left: 12px;
    padding-right: 12px;
    font-family: 'Consolas', monospace; /* Teknik/Kod fontu */
    font-size: 15px;
    font-weight: bold;
    min-height: 40px;
}

/* Kutuya tıklandığında (Odaklandığında) */
QLineEdit:focus {
    border: 2px solid #00FFC2; /* Daha parlak bir turkuaz/yeşil vurgu */
    background-color: #050505;
}

/* Mouse ile üzerine gelindiğinde hafif parlasın */
QLineEdit:hover {
    border: 1.5px solid #ffffff; /* Çerçeve beyaza yaklaşsın */
}

/* Yazı yazılamaz (Pasif) durumdayken */
QLineEdit:disabled {
    background-color: #12161c;
    color: #555555;
    border: 1.5px solid #333333;
}</string>
