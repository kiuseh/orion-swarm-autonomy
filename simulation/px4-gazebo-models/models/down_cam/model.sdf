<?xml version="1.0" encoding="UTF-8"?>
<sdf version="1.9">
  <model name="down_cam">
    <pose>0 0 0 0 0 0</pose>
    <self_collide>false</self_collide>
    <static>false</static>

    <link name="down_cam_link">
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>0.050</mass>
        <inertia>
          <ixx>0.00004</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.00004</iyy>
          <iyz>0</iyz>
          <izz>0.00004</izz>
        </inertia>
      </inertial>

      <sensor name="down_camera" type="camera">
        <gz_frame_id>down_cam_link</gz_frame_id>
        <pose>0 0 0 0 0 0</pose>

        <camera>
          <horizontal_fov>1.308996939</horizontal_fov>
          <image>
            <format>R8G8B8</format>
            <width>1280</width>
            <height>720</height>
          </image>
          <clip>
            <near>0.05</near>
            <far>1000</far>
          </clip>
        </camera>

        <always_on>1</always_on>
        <update_rate>15</update_rate>
        <visualize>false</visualize>
      </sensor>

      <gravity>true</gravity>
      <velocity_decay />
    </link>
  </model>
</sdf>
