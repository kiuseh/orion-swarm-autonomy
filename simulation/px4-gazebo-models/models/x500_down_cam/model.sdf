<?xml version="1.0" encoding="UTF-8"?>
<sdf version="1.9">
  <model name="x500_down_cam">
    <self_collide>false</self_collide>

    <include merge="true">
      <uri>x500</uri>
    </include>

    <include merge="true">
      <uri>model://down_cam</uri>
      <pose>0 0 -0.05 0 1.5707 0</pose>
      <name>down_cam</name>
    </include>

    <joint name="DownCamAttachJoint" type="fixed">
      <parent>base_link</parent>
      <child>down_cam_link</child>
      <pose relative_to="base_link">0 0 -0.05 0 1.5707 0</pose>
    </joint>
  </model>
</sdf>
